{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-annihilation/open-annihilation/main/docs/registries/schemas/error.schema.json",
  "title": "Download API error",
  "description": "Every refusal. error and message are always present. field, current_release, retry_after and challenge are present only for the codes that name them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "message"],
  "properties": {
    "error": {
      "enum": [
        "bad_request",
        "invalid_field",
        "no_viewer_address",
        "too_large",
        "unsupported_media_type",
        "unknown_package",
        "release_mismatch",
        "rate_limited",
        "internal",
        "catalogue_unavailable",
        "challenge_required",
        "unknown_challenge",
        "challenge_expired",
        "unknown_download",
        "result_recorded"
      ]
    },
    "message": { "type": "string", "minLength": 1 },
    "field": { "type": "string", "minLength": 1 },
    "current_release": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "retry_after": { "type": "integer", "minimum": 0 },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "verify", "expires"],
      "properties": {
        "code": { "type": "string" },
        "verify": { "type": "string" },
        "expires": { "type": "string" },
        "poll": { "type": "integer" }
      }
    }
  }
}
