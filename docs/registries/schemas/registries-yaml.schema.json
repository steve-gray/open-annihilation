{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-annihilation/open-annihilation/main/docs/registries/schemas/registries-yaml.schema.json",
  "title": "Registries.yaml",
  "description": "The data of the player's registry file. registries and disabled are optional. An unknown key is refused.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registries": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/added" }
    },
    "disabled": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 1, "maxLength": 32 }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "public"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
        "public": { "type": "string", "minLength": 52, "maxLength": 52 }
      }
    },
    "downloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["direct", "tokens"] },
        "api": { "type": "string" },
        "install-id": { "enum": ["required", "none"] }
      }
    },
    "added": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "catalogue", "trusted-keys", "downloads", "added", "enabled"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "url": { "type": "string" },
        "homepage": { "type": "string" },
        "catalogue": { "type": "string" },
        "mirrors": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "player-mirrors": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "trusted-keys": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/key" } },
        "downloads": { "$ref": "#/$defs/downloads" },
        "added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
